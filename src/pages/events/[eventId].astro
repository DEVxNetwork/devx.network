---
import Base from "../../layouts/Base.astro"
import { EventDetail } from "@/app/events/[eventId]/EventDetail"
import { formatOgDate, sanitizeDescription } from "@/app/events/[eventId]/og-utils"
import { listEventSlugs, loadEventPage } from "@/app/services/notion/eventPages"
import { siteConfig } from "@/app/siteConfig"

export async function getStaticPaths() {
	const slugs = await listEventSlugs()
	return slugs.map((eventId) => ({ params: { eventId } }))
}

const eventId = Astro.params.eventId
if (!eventId) {
	throw new Error("Missing event id")
}

const page = await loadEventPage(eventId)
if (!page) {
	throw new Error(`Unknown event: ${eventId}`)
}

const dated = page.gathering.start
const date = formatOgDate(dated.includes("T") ? dated : `${dated.slice(0, 10)}T20:00:00.000Z`)
const title = `${page.gathering.name} — ${date} | DEVxSD`
const description = sanitizeDescription(page.descriptionPlain) || siteConfig.description
---

<Base
	title={title}
	description={description}
	ogUrl={`${siteConfig.url}/events/${eventId}`}
	ogType="article"
>
	<EventDetail
		client:load
		gathering={page.gathering}
		descriptionHtml={page.descriptionHtml}
		seatUrl={page.seatUrl}
		map={page.map}
	/>
</Base>
