---
import Base from "../../layouts/Base.astro"
import { EventsPage } from "@/app/events/EventsPage"
import type { PublicGathering } from "@/app/content/gatherings"
import { gatheringFromEvent } from "@/app/services/luma/staticGatherings"
import { listPastEvents } from "@/app/services/luma/pastEvents"
import { coversForGatherings } from "@/app/services/luma/covers"
import { placesForGatherings } from "@/app/services/luma/places"
import { listPastGatherings, listUpcomingGatherings } from "@/app/services/notion/gatherings"
import { siteConfig } from "@/app/siteConfig"

function archiveGatherings(notionPast: PublicGathering[]): PublicGathering[] {
	const linked = new Set(notionPast.map((gathering) => gathering.href))
	const unmatched = listPastEvents()
		.filter((event) => !linked.has(`/events/${event.api_id}`))
		.map(gatheringFromEvent)

	return [...notionPast, ...unmatched].sort((a, b) => b.start.localeCompare(a.start))
}

const [upcoming, notionPast] = await Promise.all([listUpcomingGatherings(), listPastGatherings()])
const past = archiveGatherings(notionPast)
const listed = [...upcoming, ...past]
const places = placesForGatherings(listed)
const covers = coversForGatherings(listed)
---

<Base
	title={`Our Events | ${siteConfig.title}`}
	description="Every DEVx gathering, listed beside a map of where it happens."
>
	<EventsPage client:load upcoming={upcoming} past={past} places={places} covers={covers} />
</Base>
