---
import Base from "../layouts/Base.astro"
import { siteConfig } from "@/app/siteConfig"
---

<Base title={`Page not found | ${siteConfig.title}`} description="That page is not on the site.">
	<main>
		<h1>That page is not on the calendar.</h1>
		<p><a href="/">Back home</a></p>
	</main>
</Base>

<style>
	main {
		width: min(var(--column), calc(100% - 2.5rem));
		margin: 4rem auto 6rem;
	}

	a {
		color: var(--accent);
	}
</style>
