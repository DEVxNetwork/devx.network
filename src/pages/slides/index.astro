---
import Base from "../../layouts/Base.astro"
import { siteConfig } from "@/app/siteConfig"
import SlidesListClient from "@/app/slides/SlidesListClient"
import { getAllSlides } from "@/app/slides/slidesData"

const slides = getAllSlides()
---

<Base title={`Slides | ${siteConfig.title}`} description="Decks from the Saturday talks.">
	<SlidesListClient client:load slides={slides} />
</Base>
