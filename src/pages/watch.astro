---
import Base from "../layouts/Base.astro"
import { listWatchTalks } from "@/app/services/notion/talks"
import { siteConfig } from "@/app/siteConfig"
import { WatchPage } from "@/app/watch/WatchPage"

const talks = await listWatchTalks()
---

<Base title={`Watch | ${siteConfig.title}`} description="Saturday talks, filmed from the seats.">
	<WatchPage client:load talks={talks} />
</Base>
