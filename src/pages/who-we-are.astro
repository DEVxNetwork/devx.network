---
import Base from "../layouts/Base.astro"
import { missionLead } from "@/app/content/community"
import { listUpcomingGatherings } from "@/app/services/notion/gatherings"
import { siteConfig } from "@/app/siteConfig"
import { WhoWeAre } from "@/app/who-we-are/WhoWeAre"

const upcoming = await listUpcomingGatherings()
---

<Base title={`Who we are | ${siteConfig.title}`} description={missionLead}>
	<WhoWeAre client:load upcoming={upcoming} />
</Base>
