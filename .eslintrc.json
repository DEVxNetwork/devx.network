{
	"root": true,
	"parser": "@typescript-eslint/parser",
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module",
		"ecmaFeatures": {
			"jsx": true
		}
	},
	"extends": ["plugin:prettier/recommended"],
	"env": {
		"browser": true,
		"es2022": true,
		"node": true
	},
	"ignorePatterns": ["dist/**", ".astro/**", "public/**", "node_modules/**", "out/**"]
}
